---
const links = [
  { href: '/', label: '首页' },
  { href: '/blog', label: '博客' },
  { href: '/projects', label: '项目' },
  { href: '/skills', label: '技能' },
  { href: '/about', label: '关于' },
  { href: '/contact', label: '联系' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 backdrop-blur-md" style="background: color-mix(in srgb, var(--bg) 85%, transparent); border-bottom: 1px solid var(--border);">
  <nav class="container-narrow" style="height: 64px; display: flex; align-items: center; justify-content: space-between;">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-1" style="color: var(--text);">
      <span class="crosshair" style="width:14px; height:14px;"></span>
      <span style="font-family: var(--font-mono); font-weight: 600; font-size: 0.95rem; letter-spacing: 0.05em;">
        ~/blog
      </span>
    </a>

    <!-- Desktop Links -->
    <div class="md:flex items-center gap-05" style="display: none;">
      {links.map(link => (
        <a
          href={link.href}
          class="nav-link"
          style:define={{
            fontFamily: 'var(--font-mono)',
            fontSize: '0.8rem',
            padding: '0.5em 0.9em',
            borderRadius: '4px',
            color: 'var(--text-dim)',
            letterSpacing: '0.05em',
            transition: 'all 0.2s ease',
            textDecoration: 'none',
            position: 'relative',
          }}
          class:list={[
            currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) ? 'active' : ''
          ]}
        >
          {link.label}
          <span class="nav-underline" style:define={{
            position: 'absolute',
            bottom: '2px',
            left: '0.9em',
            right: '0.9em',
            height: '1px',
            background: 'var(--accent)',
            transform: 'scaleX(0)',
            transformOrigin: 'center',
            transition: 'transform 0.2s ease',
          }}></span>
        </a>
      ))}
    </div>

    <!-- Right: Theme Toggle + Mobile Menu -->
    <div class="flex items-center gap-2">
      <button
        id="theme-toggle"
        aria-label="切换主题"
        style="
          width: 36px; height: 36px;
          display: flex; align-items: center; justify-content: center;
          border: 1px solid var(--border);
          border-radius: 6px;
          background: transparent;
          color: var(--text-dim);
          cursor: pointer;
          font-size: 1rem;
          transition: all 0.2s ease;
        "
      >
        <span id="theme-icon">🌙</span>
      </button>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden"
        aria-label="菜单"
        style="
          width: 36px; height: 36px;
          display: flex; align-items: center; justify-content: center;
          border: 1px solid var(--border);
          border-radius: 6px;
          background: transparent;
          color: var(--text-dim);
          cursor: pointer;
          font-size: 1.1rem;
          transition: all 0.2s ease;
        "
      >
        <span id="menu-icon">☰</span>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    style="
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease;
      border-top: 1px solid transparent;
    "
  >
    <div class="md:hidden" style="padding: 1rem 0;">
      {links.map(link => (
        <a
          href={link.href}
          class="mobile-nav-link"
          style="
            display: block;
            font-family: var(--font-mono);
            font-size: 0.9rem;
            padding: 0.75rem 1.5rem;
            color: var(--text-dim);
            border-left: 2px solid transparent;
            transition: all 0.2s ease;
            text-decoration: none;
          "
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</header>

<style>
  /* Desktop nav link hover */
  .nav-link:hover {
    color: var(--text);
    background: var(--accent-glow);
  }
  .nav-link:hover .nav-underline {
    transform: scaleX(1);
  }
  .nav-link.active {
    color: var(--accent);
  }
  .nav-link.active .nav-underline {
    transform: scaleX(1);
  }

  /* Theme toggle hover */
  #theme-toggle:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Mobile menu button hover */
  #mobile-menu-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Mobile nav link hover */
  .mobile-nav-link:hover {
    color: var(--accent);
    border-left-color: var(--accent);
    background: var(--accent-glow);
  }
  .mobile-nav-link.active {
    color: var(--accent);
    border-left-color: var(--accent);
  }

  @media (min-width: 768px) {
    #mobile-menu-btn { display: none; }
  }
</style>

<script>
  // Theme toggle
  const themeToggle = document.getElementById('theme-toggle');
  const themeIcon = document.getElementById('theme-icon');

  function updateIcon() {
    const isLight = document.documentElement.classList.contains('light');
    themeIcon!.textContent = isLight ? '🌙' : '☀️';
  }
  updateIcon();

  themeToggle!.addEventListener('click', () => {
    document.documentElement.classList.toggle('light');
    const isLight = document.documentElement.classList.contains('light');
    localStorage.setItem('theme', isLight ? 'light' : 'dark');
    updateIcon();
  });

  // Mobile menu
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  let isOpen = false;

  mobileMenuBtn!.addEventListener('click', () => {
    isOpen = !isOpen;
    if (isOpen) {
      mobileMenu!.style.maxHeight = mobileMenu!.scrollHeight + 'px';
      mobileMenu!.style.borderTopColor = 'var(--border)';
      menuIcon!.textContent = '✕';
    } else {
      mobileMenu!.style.maxHeight = '0';
      mobileMenu!.style.borderTopColor = 'transparent';
      menuIcon!.textContent = '☰';
    }
  });

  // Close mobile menu on link click
  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', () => {
      isOpen = false;
      mobileMenu!.style.maxHeight = '0';
      mobileMenu!.style.borderTopColor = 'transparent';
      menuIcon!.textContent = '☰';
    });
  });
</script>
