---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="联系我 - 取得联系" description="通过以下方式联系我">
  <div class="container-narrow" style="padding-top: 3rem; padding-bottom: 4rem;">
    <!-- Header -->
    <header style="margin-bottom: 3rem;">
      <h1 style="
        font-size: 2rem;
        font-weight: 700;
        color: var(--text);
        margin-bottom: 0.5rem;
      ">
        <span style="color: var(--accent); margin-right: 0.5rem;">//</span>
        联系我
      </h1>
      <p style="
        font-size: 0.95rem;
        color: var(--text-dim);
      ">
        无论是技术交流、项目合作还是工作机会，欢迎随时联系。
      </p>
      <div style="height: 1px; background: var(--border); margin-top: 1.5rem;"></div>
    </header>

    <div style="
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    ">
      <!-- Left: Contact Info -->
      <div>
        <h2 style="
          font-family: var(--font-mono);
          font-size: 1.1rem;
          color: var(--text);
          margin-bottom: 1.5rem;
        ">
          联系方式
        </h2>

        <div style="display: flex; flex-direction: column; gap: 1rem;">
          <!-- Email -->
          <div class="bp-card" style="padding: 1.25rem;">
            <div style="
              font-family: var(--font-mono);
              font-size: 0.7rem;
              color: var(--text-muted);
              letter-spacing: 0.1em;
              margin-bottom: 0.5rem;
            ">
              EMAIL
            </div>
            <a href="mailto:your@email.com" style="
              font-family: var(--font-mono);
              font-size: 0.95rem;
              color: var(--accent);
              word-break: break-all;
            ">
              your@email.com
            </a>
          </div>

          <!-- GitHub -->
          <div class="bp-card" style="padding: 1.25rem;">
            <div style="
              font-family: var(--font-mono);
              font-size: 0.7rem;
              color: var(--text-muted);
              letter-spacing: 0.1em;
              margin-bottom: 0.5rem;
            ">
              GITHUB
            </div>
            <a href="https://github.com" target="_blank" rel="noopener" style="
              font-family: var(--font-mono);
              font-size: 0.95rem;
              color: var(--text);
            ">
              github.com/yourusername
            </a>
          </div>

          <!-- WeChat -->
          <div class="bp-card" style="padding: 1.25rem;">
            <div style="
              font-family: var(--font-mono);
              font-size: 0.7rem;
              color: var(--text-muted);
              letter-spacing: 0.1em;
              margin-bottom: 0.5rem;
            ">
              微信
            </div>
            <p style="
              font-family: var(--font-mono);
              font-size: 0.95rem;
              color: var(--text);
              margin: 0;
            ">
              your_wechat_id
            </p>
          </div>

          <!-- Location -->
          <div class="bp-card" style="padding: 1.25rem;">
            <div style="
              font-family: var(--font-mono);
              font-size: 0.7rem;
              color: var(--text-muted);
              letter-spacing: 0.1em;
              margin-bottom: 0.5rem;
            ">
              位置
            </div>
            <p style="
              font-family: var(--font-mono);
              font-size: 0.95rem;
              color: var(--text);
              margin: 0;
            ">
              中国 · 北京
            </p>
          </div>
        </div>
      </div>

      <!-- Right: Contact Form -->
      <div>
        <h2 style="
          font-family: var(--font-mono);
          font-size: 1.1rem;
          color: var(--text);
          margin-bottom: 1.5rem;
        ">
          发送消息
        </h2>

        <form id="contact-form" style="display: flex; flex-direction: column; gap: 1.25rem;">
          <!-- Name -->
          <div>
            <label for="name" style="
              display: block;
              font-family: var(--font-mono);
              font-size: 0.75rem;
              color: var(--text-muted);
              letter-spacing: 0.05em;
              margin-bottom: 0.5rem;
            ">
              NAME <span style="color: var(--accent);">*</span>
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="你的名字"
              style="
                width: 100%;
                padding: 0.75rem 1rem;
                font-family: var(--font-body);
                font-size: 0.9rem;
                background: var(--bg-card);
                border: 1px solid var(--border);
                border-radius: 6px;
                color: var(--text);
                outline: none;
                transition: border-color 0.2s ease;
              "
            />
          </div>

          <!-- Email -->
          <div>
            <label for="email" style="
              display: block;
              font-family: var(--font-mono);
              font-size: 0.75rem;
              color: var(--text-muted);
              letter-spacing: 0.05em;
              margin-bottom: 0.5rem;
            ">
              EMAIL <span style="color: var(--accent);">*</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="your@email.com"
              style="
                width: 100%;
                padding: 0.75rem 1rem;
                font-family: var(--font-body);
                font-size: 0.9rem;
                background: var(--bg-card);
                border: 1px solid var(--border);
                border-radius: 6px;
                color: var(--text);
                outline: none;
                transition: border-color 0.2s ease;
              "
            />
          </div>

          <!-- Subject -->
          <div>
            <label for="subject" style="
              display: block;
              font-family: var(--font-mono);
              font-size: 0.75rem;
              color: var(--text-muted);
              letter-spacing: 0.05em;
              margin-bottom: 0.5rem;
            ">
              SUBJECT
            </label>
            <input
              type="text"
              id="subject"
              name="subject"
              placeholder="消息主题"
              style="
                width: 100%;
                padding: 0.75rem 1rem;
                font-family: var(--font-body);
                font-size: 0.9rem;
                background: var(--bg-card);
                border: 1px solid var(--border);
                border-radius: 6px;
                color: var(--text);
                outline: none;
                transition: border-color 0.2s ease;
              "
            />
          </div>

          <!-- Message -->
          <div>
            <label for="message" style="
              display: block;
              font-family: var(--font-mono);
              font-size: 0.75rem;
              color: var(--text-muted);
              letter-spacing: 0.05em;
              margin-bottom: 0.5rem;
            ">
              MESSAGE <span style="color: var(--accent);">*</span>
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows="5"
              placeholder="写下你的消息..."
              style="
                width: 100%;
                padding: 0.75rem 1rem;
                font-family: var(--font-body);
                font-size: 0.9rem;
                background: var(--bg-card);
                border: 1px solid var(--border);
                border-radius: 6px;
                color: var(--text);
                outline: none;
                transition: border-color 0.2s ease;
                resize: vertical;
              "
            ></textarea>
          </div>

          <!-- Submit -->
          <button
            type="submit"
            class="bp-btn bp-btn--filled"
            style="align-self: flex-start;"
          >
            发送消息 →
          </button>
        </form>

        <!-- Success message (hidden by default) -->
        <div id="success-msg" style="
          display: none;
          margin-top: 1rem;
          padding: 1rem;
          background: var(--accent-glow);
          border: 1px solid var(--accent);
          border-radius: 6px;
          font-family: var(--font-mono);
          font-size: 0.85rem;
          color: var(--accent);
        ">
          ✓ 消息已发送，我会尽快回复！
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form');
  const successMsg = document.getElementById('success-msg');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    // TODO: Replace with actual form submission (e.g., Formspree, EmailJS)
    // For now, just show the success message
    form.style.display = 'none';
    successMsg!.style.display = 'block';
  });

  // Input focus effects
  form?.querySelectorAll('input, textarea').forEach(input => {
    input.addEventListener('focus', () => {
      (input as HTMLElement).style.borderColor = 'var(--accent)';
    });
    input.addEventListener('blur', () => {
      (input as HTMLElement).style.borderColor = 'var(--border)';
    });
  });
</script>

<style>
  /* Grid layout responsive */
  @media (max-width: 768px) {
    div[style*="grid-template-columns: 1fr 1fr"] {
      grid-template-columns: 1fr !important;
    }
  }
</style>
